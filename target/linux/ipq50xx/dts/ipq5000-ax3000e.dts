/dts-v1/;

#include "ipq5018.dtsi"

/ {
	model = "Xiaomi AX3000E";
	compatible = "xiaomi,ax3000e", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &blsp1_uart1;

		ethernet0 = &mac0;
		ethernet1 = &mac1;

		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
	};

	chosen {
		// Override the root parameter from u-boot
		bootargs-append = " root=/dev/ubiblock0_1";
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
			reg = <0x0 0x4b000000 0x0 0x3b00000>;
#else
			reg = <0x0 0x4b000000 0x0 0x3000000>;
#endif
		};
	};

	thermal-zones {
		status = "ok";
	};
};

&tmc_etr {
	/delete-property/ memory_region;
};

&qgic_msi_0 {
	status = "ok";
};

&qgic_msi_1 {
	status = "ok";
};

&tlmm {
	blsp_uart0_pins: blsp_uart0_pins {
            rx {
                    pins = "gpio21";
                    function = "blsp0_uart0";
                    bias-pull-up;
            };
            tx {
                    pins = "gpio20";
                    function = "blsp0_uart0";
                    drive-strength = <8>;
                    bias-disable;
            };
    };

	qspi_nand_pins: qspi_nand_pins {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data0 {
			pins = "gpio7";
			function = "qspi0";
			drive-strength = <8>;
			bias-disable;
		};

		data1 {
			pins = "gpio6";
			function = "qspi1";
			drive-strength = <8>;
			bias-disable;
		};

		data2 {
			pins = "gpio5";
			function = "qspi2";
			drive-strength = <8>;
			bias-disable;
		};

		data3 {
			pins = "gpio4";
			function = "qspi3";
			drive-strength = <8>;
			bias-disable;
		};
	};

	mdio1_pins: mdio1_pins {
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds_pins {
		led_system_blue {
			pins = "gpio24";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_system_yellow {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

	};

	button_pins: button_pins {
		button_reset {
			pins = "gpio38";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		button_mesh {
			pins = "gpio28";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&blsp_uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&qpic_bam {
	status = "ok";
};

&nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&qfprom {
	status = "ok";
};

&tsens {
	status = "ok";
};

&soc {
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: led_system_blue {
			label = "blue:system";
			gpio = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_system_yellow: led_system_yellow {
			label = "yellow:system";
			gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};
	};

	button {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button_reset {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		button_mesh {
			label = "mesh";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	ess-instance {
		num_devices = <1>; // Changed from 2 to 1 (Deleted QCA chip)

		ess-switch@0x39c00000 {
			compatible = "qcom,ess-switch-ipq50xx";
			/* Both taken from stock RN07 DTS and both were MISSING here.
			 * Without reg + "local bus" access mode, ssdk cannot map the
			 * SoC ESS/UNIPHY register space, so the GMAC1<->uniphy0 data
			 * path is never configured -- the SGMII link still trains but
			 * no frame crosses it in either direction.
			 */
			reg = <0x39c00000 0x200000>;
			switch_access_mode = "local bus";
			device_id = <0>;

			/* Taken verbatim from stock RN07 DTS. Without these the UNIPHY /
			 * GMAC1 RX+TX datapath clocks are never enabled: the SerDes still
			 * trains (port 8 shows link:up 2500) but not a single frame moves
			 * in either direction. nss_port2_rx/tx_clk = GCC_GMAC1_RX/TX_CLK.
			 */
			clocks = <&gcc 40>,
				<&gcc 41>,
				<&gcc 134>,
				<&gcc 136>,
				<&gcc 71>,
				<&gcc 72>,
				<&gcc 55>,
				<&gcc 58>,
				<&gcc 60>,
				<&gcc 63>,
				<&gcc 53>,
				<&gcc 54>,
				<&gcc 135>,
				<&gcc 137>,
				<&gcc 57>,
				<&gcc 59>,
				<&gcc 62>,
				<&gcc 64>,
				<&gcc 110>,
				<&gcc 112>,
				<&gcc 56>,
				<&gcc 61>;
			clock-names = "cmn_ahb_clk",
				"cmn_sys_clk",
				"uniphy_ahb_clk",
				"uniphy_sys_clk",
				"gcc_mdio0_ahb_clk",
				"gcc_mdio1_ahb_clk",
				"gcc_gmac0_cfg_clk",
				"gcc_gmac0_sys_clk",
				"gcc_gmac1_cfg_clk",
				"gcc_gmac1_sys_clk",
				"uniphy0_port1_rx_clk",
				"uniphy0_port1_tx_clk",
				"uniphy1_port5_rx_clk",
				"uniphy1_port5_tx_clk",
				"nss_port1_rx_clk",
				"nss_port1_tx_clk",
				"nss_port2_rx_clk",
				"nss_port2_tx_clk",
				"gcc_snoc_gmac0_ahb_clk",
				"gcc_snoc_gmac1_ahb_clk",
				"gcc_gmac0_ptp_clk",
				"gcc_gmac1_ptp_clk";
			resets = <&gcc 17>,
				<&gcc 93>,
				<&gcc 22>,
				<&gcc 25>,
				<&gcc 110>,
				<&gcc 111>;
			reset-names = "gephy_bcr_rst",
				"uniphy_bcr_rst",
				"gmac0_bcr_rst",
				"gmac1_bcr_rst",
				"uniphy1_soft_rst",
				"gephy_misc_rst";

			cmnblk_clk = "internal_96MHz";

			// Set to SGMII-Plus for the Motorcomm Uplink
			switch_mac_mode = <0xc>; 

			qcom,port_phyinfo {
				// MAC0 -> GE Phy 
				port@0 {
					port_id = <1>;
					mdiobus = <&mdio0>;
					phy_address = <7>;
					phy_dac = <0x10 0x10>;
				};

				// MAC1 ---SGMII-Plus---> Motorcomm YT9215S (2.5Gbps)
				port@1 {
					port_id = <2>;
					/* stock RN07 DTS has NO port_mac_sel here */
					forced-speed = <2500>;
					forced-duplex = <1>;
				};
			};
		};
	};

	 yt9215: switch@1d {
                compatible = "motorcomm,yt9215-smi";
                mdio-bus = <&mdio1>;
                mdio-addr = <0x1d>;

                /* AX3000E-only: enables the stock-verified raw CPU-uplink
                 * (port 8) register values and the self-healing port-8
                 * monitor in yt9215.c. Other YT9215S boards (cr881x) omit
                 * this and keep the driver's original behaviour. */
                motorcomm,cpu-uplink-quirk;

                /* Derived from the stock vendor module's yt_hw_reset():
                 * gpio_request(39, "yt-hw-reset"), driven low for 100ms,
                 * then released high and left 100ms to settle, before any
                 * SMI/MDIO access happens. GPIO number and both delays are
                 * taken verbatim from the vendor driver's disassembly.
                 */
                reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
                reset-assert-us = <100000>;
                reset-deassert-us = <100000>;

                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;

                        port@0 { reg = <0>; };
                        port@1 { reg = <1>; };
                        port@2 { reg = <2>; };
                        port@3 { reg = <3>; };
                        port@4 { reg = <4>; };
                        port@8 {
                                reg = <8>;
                                phy-mode = "2500base-x";
                                fixed-link {
                                        speed = <2500>;
                                        full-duplex;
                                };
                        };
                };
        };


	// MAC0 -> GE Phy
	mac0: dp1 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <1>;

		reg = <0x39C00000 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		mdio-bus = <&mdio0>;
		qcom,phy-mdio-addr = <7>;
		phy-mode = "sgmii";
		qcom,link-poll = <1>;
	};

	// MAC1 ---SGMII-Plus---> Motorcomm YT9215S SerDes (2.5Gbps)
	mac1: dp2 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <2>;

		reg = <0x39D00000 0x10000>;
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		/* Stock RN07 DTS uses "sgmii" here, NOT "2500base-x": the rate
		 * comes from ess-switch's forced-speed = <2500> on port_id=2.
		 * Setting 2500base-x deviates from stock and broke eth0 RX.
		 */
		phy-mode = "sgmii";
	};
};

&mdio0 {
	status = "ok";

	// IPQ5018 GE Phy -> QCA8337 Phy4
	ethernet-phy@0 {
		reg = <7>;
	};
};

&mdio1 {
        pinctrl-0 = <&mdio1_pins>;
        pinctrl-names = "default";
        status = "ok";
};

&qcom_q6v5_wcss {
	qcom,multipd_arch;
	memory-region = <&q6_mem_regions>;

	qcom,share_bootargs;
	qcom,bootargs_smem = <507>;
	boot-args = </*       type: */ 0x2 /* PCIE1 */
		     /*     length: */ 4
		     /*      PD id: */ 2
		     /* reset GPIO: */ 18
		     /*   reserved: */ 0 0>;

	// IPQ5018
	q6v5_wcss_userpd1 {
		qca,asid = <1>;

		interrupts-extended =
			<&wcss_smp2p_in 8 0>,
			<&wcss_smp2p_in 9 0>,
			<&wcss_smp2p_in 12 0>,
			<&wcss_smp2p_in 11 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn_ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 8>,
			<&wcss_smp2p_out 9>,
			<&wcss_smp2p_out 10>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		m3_firmware = "IPQ5018/m3_fw.mdt";
		qca,auto-restart;
		qca,int_radio;
	};

	// QCN6102
	q6v5_wcss_userpd2 {
		qca,asid = <2>;

		interrupts-extended =
			<&wcss_smp2p_in 16 0>,
			<&wcss_smp2p_in 17 0>,
			<&wcss_smp2p_in 20 0>,
			<&wcss_smp2p_in 19 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn_ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 16>,
			<&wcss_smp2p_out 17>,
			<&wcss_smp2p_out 18>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		m3_firmware = "qcn6122/m3_fw.mdt";
		qca,auto-restart;
	};
};

&wifi0 {
	// IPQ5000
	qcom,multipd_arch;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";

	// Be overridden by /etc/hotplug.d/firmware/10-ath11k-board_id
	// M79: 0x10
	// M81: 0x24
	qcom,board_id = <0x24>;

	qcom,bdf-addr = <0x4c400000 0x4c400000 0x4c400000 0 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	qcom,caldb-addr = <0x4d200000>;
	m3-dump-addr = <0x4d400000>;
#else
	qcom,caldb-addr = <0>;
	m3-dump-addr = <0>;
#endif

	status = "ok";
};

&wifi1 {
	// QCN6102
	qcom,multipd_arch;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";

	qcom,board_id = <0x60>;

	qcom,bdf-addr = <0x4d500000 0x4d500000 0x4d100000 0 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	qcom,caldb-addr = <0x4e500000>;
	m3-dump-addr = <0x4ea00000>;
#else
	qcom,caldb-addr = <0>;
	m3-dump-addr = <0x4df00000>;
#endif

	status = "ok";
};
